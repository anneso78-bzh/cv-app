{
  "name": "cv-ccm-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently -k \"npm:server:dev\" \"npm:serve:dev\"",
    "serve:dev": "ng serve --port 4300",
    "server:dev": "tsx server/server.ts",
    "build": "ng build && tsc -p tsconfig.server.json",
    "start:server": "node dist/server/server.js",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "express": "^5.1.0",
    "pdfkit": "^0.17.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@types/express": "^5.0.3",
    "@types/node": "^26.0.0",
    "@types/pdfkit": "^0.17.3",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
